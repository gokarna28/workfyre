<!DOCTYPE html>
<html>
<head>
    <title>Payment Receipt - PDF Download</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .download-note { 
            background: #e3f2fd; 
            border: 1px solid #2196f3; 
            padding: 15px; 
            border-radius: 5px; 
            margin-bottom: 20px; 
        }
        .download-note h3 { margin: 0 0 10px 0; color: #1976d2; }
        .download-note p { margin: 5px 0; }
        .download-buttons { margin: 20px 0; }
        .btn { 
            display: inline-block; 
            padding: 10px 20px; 
            margin: 5px; 
            background: #1c5f5f; 
            color: white; 
            text-decoration: none; 
            border-radius: 5px; 
            font-weight: bold; 
        }
        .btn:hover { background: #59b76e; }
    </style>
</head>
<body>
    <div class="download-note">
        <h3>📄 Payment Receipt Ready for Download</h3>
        <p><strong>Receipt ID:</strong> 40</p>
        <p><strong>Amount:</strong> ₹30,000.00</p>
        <p><strong>Payer:</strong> Aangkami</p>
        <p><strong>Date:</strong> July 24, 2025</p>
    </div>
    
    <div class="download-buttons">
        <a href="#" onclick="window.print(); return false;" class="btn">🖨️ Print as PDF</a>
        <a href="#" onclick="downloadAsPDF(); return false;" class="btn">📥 Download PDF</a>
        <a href="admin_payments.php" class="btn">← Back to Payments</a>
    </div>
    
    <div style="margin-top: 30px;">
        
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Receipt</title>
    <style>
        @page {
            margin: 20mm;
            size: A4;
        }
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: white;
            font-size: 12px;
            line-height: 1.4;
        }
        .receipt-container {
            max-width: 100%;
            margin: 0 auto;
            background: white;
            border: 2px solid #1c5f5f;
            border-radius: 8px;
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #1c5f5f 0%, #59b76e 100%);
            color: white;
            padding: 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: bold;
        }
        .header p {
            margin: 5px 0 0 0;
            font-size: 14px;
            opacity: 0.9;
        }
        .content {
            padding: 20px;
        }
        .receipt-number {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 4px solid #1c5f5f;
        }
        .receipt-number h2 {
            margin: 0 0 8px 0;
            color: #1c5f5f;
            font-size: 16px;
        }
        .receipt-number p {
            margin: 3px 0;
            font-size: 12px;
            color: #666;
        }
        .amount-section {
            background: #e8f5e8;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            text-align: center;
            border: 2px solid #59b76e;
        }
        .amount-section h3 {
            margin: 0 0 8px 0;
            color: #1c5f5f;
            font-size: 14px;
        }
        .amount {
            font-size: 24px;
            font-weight: bold;
            color: #59b76e;
            margin: 8px 0;
        }
        .details-grid {
            display: table;
            width: 100%;
            margin-bottom: 20px;
        }
        .detail-section {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding-right: 10px;
        }
        .detail-section:last-child {
            padding-right: 0;
            padding-left: 10px;
        }
        .detail-section h4 {
            margin: 0 0 12px 0;
            color: #1c5f5f;
            font-size: 14px;
            border-bottom: 2px solid #1c5f5f;
            padding-bottom: 3px;
        }
        .detail-row {
            display: table;
            width: 100%;
            margin-bottom: 6px;
            font-size: 11px;
        }
        .detail-label {
            display: table-cell;
            width: 40%;
            color: #666;
            font-weight: 500;
        }
        .detail-value {
            display: table-cell;
            width: 60%;
            color: #333;
            font-weight: 600;
        }
        .loan-progress {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
        .loan-progress h4 {
            margin: 0 0 12px 0;
            color: #1c5f5f;
            font-size: 14px;
        }
        .progress-bar {
            background: #e9ecef;
            border-radius: 8px;
            height: 16px;
            overflow: hidden;
            margin-bottom: 8px;
        }
        .progress-fill {
            background: linear-gradient(90deg, #59b76e 0%, #1c5f5f 100%);
            height: 100%;
            border-radius: 8px;
        }
        .progress-text {
            display: table;
            width: 100%;
            font-size: 11px;
            color: #666;
            margin-bottom: 4px;
        }
        .progress-text span {
            display: table-cell;
            width: 50%;
        }
        .footer {
            background: #f8f9fa;
            padding: 15px;
            text-align: center;
            border-top: 1px solid #dee2e6;
        }
        .footer p {
            margin: 3px 0;
            font-size: 10px;
            color: #666;
        }
        .stamp {
            position: absolute;
            top: 50%;
            right: 30px;
            transform: translateY(-50%);
            width: 60px;
            height: 60px;
            border: 2px solid #59b76e;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            color: #59b76e;
            font-weight: bold;
            font-size: 10px;
            text-align: center;
            line-height: 1.2;
        }
        .page-break {
            page-break-before: always;
        }
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .receipt-container {
                box-shadow: none;
                border-radius: 0;
            }
        }
    </style>
</head>
<body>
    <div class="receipt-container">
        <div class="header">
            <h1>PAYMENT RECEIPT</h1>
            <p>Loan Management System</p>
        </div>
        
        <div class="content">
            <div class="receipt-number">
                <h2>Receipt Details</h2>
                <p><strong>Receipt No:</strong> 40</p>
                <p><strong>Bill No:</strong> 4424</p>
                <p><strong>Date:</strong> July 24, 2025</p>
                <p><strong>Time:</strong> 10:00 PM</p>
            </div>
            
            <div class="amount-section">
                <h3>Payment Amount</h3>
                <div class="amount">₹30,000.00</div>
                <p style="margin: 0; color: #666; font-size: 11px;">Payment Position: 2 of 2 payments</p>
            </div>
            
            <div class="details-grid">
                <div class="detail-section">
                    <h4>Payer Information</h4>
                    <div class="detail-row">
                        <span class="detail-label">Name:</span>
                        <span class="detail-value">Aangkami</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email:</span>
                        <span class="detail-value">aang@gmail.com</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">PAN:</span>
                        <span class="detail-value">123456</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Profession:</span>
                        <span class="detail-value">student</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Address:</span>
                        <span class="detail-value">ktm</span>
                    </div>
                </div>
                
                <div class="detail-section">
                    <h4>Loan Information</h4>
                    <div class="detail-row">
                        <span class="detail-label">Loan ID:</span>
                        <span class="detail-value">38</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Loan Type:</span>
                        <span class="detail-value">Personal Loan</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Loan Plan:</span>
                        <span class="detail-value">6-Months 5% Interest</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Loan Amount:</span>
                        <span class="detail-value">₹52,500.00</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Loan Status:</span>
                        <span class="detail-value">Approved</span>
                    </div>
                </div>
            </div>
            
            <div class="loan-progress">
                <h4>Loan Progress</h4>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 65.47619047619%"></div>
                </div>
                <div class="progress-text">
                    <span>Total Paid: ₹34,375.00</span>
                    <span>Remaining: ₹18,125.00</span>
                </div>
                <div class="progress-text">
                    <span>Progress: 65.5%</span>
                    <span>Payments: 2</span>
                </div>
            </div>
        </div>
        
        <div class="footer">
            <p><strong>This is a computer generated receipt and does not require a signature.</strong></p>
            <p>For any queries, please contact our support team.</p>
            <p>Generated on: July 24, 2025 at 05:53 PM</p>
        </div>
        
        <div class="stamp">
            PAID<br>✓
        </div>
    </div>
</body>
</html>
    </div>
    
    <script>
        function downloadAsPDF() {
            // Create a new window with just the receipt content
            const receiptWindow = window.open("", "_blank");
            receiptWindow.document.write(`
